<script>
$(function(){
    <?if ($board_status !== false):?>

    initFanDriveDropdowns(false);
    initFanGroupDropdowns(false);
    $('form[name="fanctrl_options"]').on('submit', prepareFanGroupSubmit);
    $('#fan-group-clear').on('click', clearFanGroupEditor);
    $('#fan-group-sensors, #fan-group-temphdd').on('change', syncFanGroupSpindownVisibility);
    syncFanGroupSpindownVisibility();

    // check if board supports ipmi
    $('#tab2').click(function() {
        checkBoard();
        initFanDriveDropdowns(true);
        initFanGroupDropdowns(true);
    });

    if($.cookie('one') == 'tab2')
        checkBoard();

    //advanced vBOARDiew switch set cookie and toggle advanced columns
    $('#advancedview').switchButton({
        labels_placement: 'left',
        on_label: 'Advanced View',
        off_label: 'Basic View',
        checked: ($.cookie('fanctrl_view_mode') == 'advanced')
    })
    .change(function () {
        //$('.fanctrl-settings').toggle('slow');
        $.cookie('fanctrl_view_mode', $('#advancedview')[0].checked ? 'advanced' : 'basic', { expires: 3650 });
        toggleFanCTRL();
        $('.fanctrl-temp').trigger('change');
        syncFanGroupSpindownVisibility();
    });

    // Set a deterministic initial state to avoid settings text flashing on first paint.
    $('.fanctrl-settings').hide();
    $('.fanctrl-basic').show();
    toggleFanCTRL();

    // toggle auto disables settings
    function syncSpindownDetailState(fanSuffix) {
        var primarySelector = "select[name='TEMP_" + fanSuffix + "']";
        var spindownSelector = "select[name='TEMPHDD_" + fanSuffix + "']";
        var detailClass = '.fan-spindown-' + fanSuffix;
        var spindownValue = parseInt($(spindownSelector).val() || '0', 10);
        var showAdvanced = ($.cookie('fanctrl_view_mode') == 'advanced');
        var showDetails = showAdvanced && ($(primarySelector).val() === '99') && (spindownValue > 0) && !$(spindownSelector).prop('disabled');
        $(detailClass).toggle(showDetails);
    }

    function syncHddSpindownSensorState(tempSelect) {
        var tempName = $(tempSelect).attr('name') || '';
        if (tempName.indexOf('TEMP_') !== 0 || tempName.indexOf('TEMPHDD_') === 0) {
            return;
        }

        var fanSuffix = tempName.substring(5);
        var spindownSelector = "select[name='TEMPHDD_" + fanSuffix + "']";
        var enableSpindownSensor = ($(tempSelect).val() === '99');
        $(spindownSelector).prop('disabled', !enableSpindownSensor);
        syncSpindownDetailState(fanSuffix);
    }

    $('.fanctrl-temp')
        .each(function() {
            var FanName = '.' + $(this).attr('name');
            $(FanName).prop('disabled', ($(this)[0].selectedIndex == 0));
            syncHddSpindownSensorState(this);
            var tempName = $(this).attr('name') || '';
            if (tempName.indexOf('TEMPHDD_') === 0) {
                syncSpindownDetailState(tempName.substring(8));
            }
        })
        .on('change', function() {
            var FanName = '.' + $(this).attr('name');
            $(FanName).prop('disabled', ($(this)[0].selectedIndex == 0));
            syncHddSpindownSensorState(this);
            var tempName = $(this).attr('name') || '';
            if (tempName.indexOf('TEMPHDD_') === 0) {
                syncSpindownDetailState(tempName.substring(8));
            }
        });

    $('.fanctrl-enable')
        .each(function() {
            $(this).closest('.fan-block').attr('data-enabled', ($(this).val() === '0') ? '0' : '1');
        })
        .on('change', function() {
            $(this).closest('.fan-block').attr('data-enabled', ($(this).val() === '0') ? '0' : '1');
            syncFanConfigVisibility();
            sortFanBlocks();
        });

    sortFanBlocks();

    $('#btnConfig').click(function() {
                openBox('/plugins/ipmi/scripts/ipmi2json', 'IPMI Fan Config', 600, 900, true);
    });

    $('#FAN_DEFAULT').click(resetFANDATA);
    $('#FANCONTROL').change(checkFANCTRL)
    checkFANCTRL();


    $('#fanlog-clear').on('click', clearFanLOG);

    <?endif;?>

    $('#readings').click(function() {
        $.cookie('one', 'tab1', { expires:null, path: '/'});
        location ='/Tools/IPMITools';
    });

});

<?if ($board_status !== false):?>

function resetFANDATA() {
    $('#FANCONTROL')[0].selectedIndex = 0;
    $('#FANPOLL')[0].selectedIndex = 5;
    $('#HDDPOLL')[0].selectedIndex = 2;
    $('#FANIP')[0].selectedIndex = 0;
    $('#fanctrl_settings').submit();
}

/* empty fan log */
function clearFanLOG() {
    $.get('/plugins/ipmi/include/fanlog_clear.php', {},function() {
        $('#fanlog-size').html('0');
    });
}


function DDCheckList(Select,Values,firstItemChecksAll) {
    $(Select).dropdownchecklist( {
        emptyText: 'Nothing Available',
        icon: {placement: 'right', toOpen: 'ui-icon-triangle-1-s', toClose: 'ui-icon-triangle-1-n'},
        width: 300,
        explicitClose: 'close',
        firstItemChecksAll: (firstItemChecksAll !== false),
        textFormatFunction: function(options) { return 'Select'; },
        onComplete: function(selector){
            if (!Values) return;
            var values = '';
            var Size = selector.options.length;
            for (var i=1; i < Size; i++ ) {
                if ((selector.options[i].selected == false) && (selector.options[i].value !== '')){
                    if (values != '') values += ',';
                    values += selector.options[i].value;
                }
            }
            $(Values).val(values);
        }
    });
}

function initFanDriveDropdowns(remove) {
    $('.fanctrl-drive-select').each(function() {
        var hiddenSelector = $(this).data('hidden');
        if (remove) {
            $(this).dropdownchecklist('destroy');
        }
        DDCheckList(this, hiddenSelector, true);
    });
}

function initFanGroupDropdowns(remove) {
    if ($('#fan-group-fans').length) {
        if (remove) $('#fan-group-fans').dropdownchecklist('destroy');
        DDCheckList('#fan-group-fans', null, false);
    }
    if ($('#fan-group-sensors').length) {
        if (remove) $('#fan-group-sensors').dropdownchecklist('destroy');
        DDCheckList('#fan-group-sensors', null, false);
    }
    if ($('#fan-group-hdds').length) {
        if (remove) $('#fan-group-hdds').dropdownchecklist('destroy');
        DDCheckList('#fan-group-hdds', null, true);
    }
}

function fanGroupArray(selector) {
    var val = $(selector).val() || [];
    if (!$.isArray(val)) val = [val];
    return $.grep(val, function(item) { return item !== ''; });
}

function normalizeFanGroupId(name) {
    return String(name || '').toUpperCase().replace(/[^A-Z0-9_]/g, '_').replace(/^_+|_+$/g, '');
}

function currentFanGroups() {
    var raw = $('#FANGROUPS').val() || '';
    return $.grep($.map(raw.split(','), function(item) { return $.trim(item); }), function(item) { return item !== ''; });
}

function setFanGroups(groups) {
    var seen = {};
    var clean = [];
    $.each(groups, function(_, group) {
        group = normalizeFanGroupId(group);
        if (group && !seen[group]) {
            seen[group] = true;
            clean.push(group);
        }
    });
    $('#FANGROUPS').val(clean.join(','));
}

function syncFanGroupSpindownVisibility() {
    var hasHddSensor = ($.inArray('99', fanGroupArray('#fan-group-sensors')) >= 0);
    var spindownValue = String($('#fan-group-temphdd').val() || '0');
    $('.fan-group-hdd-row').toggle(hasHddSensor);
    $('#fan-group-temphdd').prop('disabled', !hasHddSensor);
    if (!hasHddSensor) {
        $('#fan-group-temphdd').val('0');
        spindownValue = '0';
    }
    $('.fan-group-spindown-detail-row').toggle(hasHddSensor && spindownValue !== '0');
}

function clearFanGroupEditor() {
    $('#fan-group-edit-id').val('');
    $('#fan-group-name').val('');
    $('#fan-group-fans, #fan-group-sensors, #fan-group-hdds').val([]).trigger('change');
    syncFanGroupSpindownVisibility();
}

function editFanGroup(groupId) {
    var row = $('.fan-group-row[data-group="' + groupId + '"]');
    $('#fan-group-edit-id').val(groupId);
    $('#fan-group-name').val(groupId);
    $('#fan-group-fans').val((row.data('fans') || '').split(',')).trigger('change');
    $('#fan-group-sensors').val((row.data('sensors') || '').split(',')).trigger('change');
    $('#fan-group-hdds').val((row.data('hdds') || '').split(',')).trigger('change');
    $('#fan-group-temphdd').val(row.data('temphdd') || '0');
    $('#fan-group-temphi').val(row.data('temphi') || '45');
    $('#fan-group-templo').val(row.data('templo') || '30');
    $('#fan-group-fanmax').val(row.data('fanmax') || '64');
    $('#fan-group-fanmin').val(row.data('fanmin') || '16');
    $('#fan-group-temphio').val(row.data('temphio') || '45');
    $('#fan-group-temploo').val(row.data('temploo') || '30');
    $('#fan-group-fanmaxo').val(row.data('fanmaxo') || '64');
    $('#fan-group-fanmino').val(row.data('fanmino') || '16');
    syncFanGroupSpindownVisibility();
}

function removeFanGroup(groupId) {
    setFanGroups($.grep(currentFanGroups(), function(group) { return group !== groupId; }));
    $('form[name="fanctrl_options"]').submit();
}

function prepareFanGroupSubmit() {
    var fans = fanGroupArray('#fan-group-fans');
    var sensors = fanGroupArray('#fan-group-sensors');
    var hasEditorSelection = fans.length || sensors.length || ($('#fan-group-name').val() || $('#fan-group-edit-id').val());
    if (!hasEditorSelection) return true;

    var groupId = normalizeFanGroupId($('#fan-group-edit-id').val() || $('#fan-group-name').val());
    if (!groupId) {
        groupId = 'GROUP_' + (currentFanGroups().length + 1);
    }
    $('#fan-group-edit-id').val(groupId);
    $('#fan-group-name').val(groupId);
    setFanGroups(currentFanGroups().concat([groupId]));

    $('#fan-group-fans-hidden').attr('name', 'FANS_' + groupId).val(fans.join(','));
    $('#fan-group-sensors-hidden').attr('name', 'SENSORS_' + groupId).val(sensors.join(','));
    $('#fan-group-hdds-hidden').attr('name', 'HDDINCLUDE_' + groupId).val(fanGroupArray('#fan-group-hdds').join(','));
    $('[data-group-field]').each(function() {
        var field = $(this).data('group-field');
        if (field === 'FANS' || field === 'SENSORS' || field === 'HDDINCLUDE') return;
        $(this).attr('name', field + '_' + groupId);
    });
    return true;
}

function sortFanBlocks() {
    var fanBlocks = $('.fan-block').get();
    fanBlocks.sort(function(a, b) {
        var aEnabled = parseInt($(a).attr('data-enabled') || '1', 10);
        var bEnabled = parseInt($(b).attr('data-enabled') || '1', 10);
        return bEnabled - aEnabled;
    });

    $.each(fanBlocks, function(_, block) {
        $(block).appendTo('#fanctrl-options');
    });
}

function syncFanConfigVisibility() {
    var showAdvanced = ($.cookie('fanctrl_view_mode') == 'advanced');
    $('.fanctrl-enable').each(function() {
        var fanClass = '.fan-config-' + $(this).data('fan');
        var fanEnabled = ($(this).val() !== '0');
        $(fanClass).toggle(showAdvanced && fanEnabled);
    });
}

function checkFANCTRL() {
    if ($('#FANCONTROL')[0].selectedIndex < 1 ) {
        $('#FANCMD').val('/usr/local/emhttp/plugins/ipmi/scripts/fanctrl_stop');
    }else {
        $('#FANCMD').val('/usr/local/emhttp/plugins/ipmi/scripts/fanctrl_start');
    }

    if ("<?=$fanctrl_run;?>" == true)
    {
        $('.fanctrl-run').prop('disabled', true);
        $('#btnFanApply').disabled = 'disabled';
    }else{
        $('.fanctrl-run').prop('disabled', false);
        $('#btnFanApply').prop('disabled', false);
    }
}

function checkBoard() {
    if ("<?=$board_file_status;?>" == false) {
       swal({title:'Fan Config JSON File Missing!',text:'You have not configured your fans yet. Stop Fan Control and Click the Configure button below to test your fans and determine their location for fan control. All fans will initially be set to full speed. Each location will be tested at one third speed to determine which fan is present. This will take about 1 min. On completion fans will return to auto and you can start fan control.',type:'warning',closeOnConfirm: true,},function() {
       });
    }
}

function toggleFanCTRL() {
    if ($.cookie('fanctrl_view_mode') == 'advanced') {
        $('.fanctrl-settings').show();
        $('.fanctrl-basic').hide();
    }else{
        $('.fanctrl-basic').show();
        $('.fanctrl-settings').hide();
    }
    syncFanConfigVisibility();
}
<?endif;?>
</script>
