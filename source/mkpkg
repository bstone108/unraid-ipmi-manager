#!/bin/bash
set -euo pipefail

if [ $# -eq 0 ]; then
    echo "Usage: mkpkg directory_name"
    exit 1
fi

DIR="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/${*}"
TMPDIR=/tmp/tmp.$(( RANDOM * 19318203981230 + 40 ))
PLUGIN=$(basename "${DIR}")
ARCHIVE="$(dirname "$(dirname "${DIR}")")/archive"
PLG_FILE="$(dirname "$(dirname "${DIR}")")/plugin/${PLUGIN}.plg"
DEV_PLG_FILE="$(dirname "$(dirname "${DIR}")")/plugin/${PLUGIN}-dev.plg"
VERSION_FILE="$(dirname "$(dirname "${DIR}")")/VERSION"
BASE_VERSION=$(TZ=America/Chicago date +"%Y.%m.%d")
ARCH="-x86_64-1"
VERSION=""
PACKAGE=""
MD5=""

mkdir -p "${ARCHIVE}"
last_build=0
for existing in "${ARCHIVE}/${PLUGIN}-${BASE_VERSION}."[0-9][0-9]"${ARCH}".txz; do
    [[ -e "${existing}" ]] || continue
    existing_version=$(basename "${existing}")
    existing_version=${existing_version#${PLUGIN}-${BASE_VERSION}.}
    existing_version=${existing_version%${ARCH}.txz}
    if [[ "${existing_version}" =~ ^[0-9][0-9]$ ]] && (( 10#${existing_version} > last_build )); then
        last_build=$((10#${existing_version}))
    fi
done

for build in $(seq $((last_build + 1)) 99); do
    candidate=$(printf "%s.%02d" "${BASE_VERSION}" "${build}")
    PKG="${ARCHIVE}/${PLUGIN}-${candidate}${ARCH}.txz"
    if [[ ! -f $PKG ]]; then
        VERSION="${candidate}"
        PACKAGE="${PKG}"
        MD5="${ARCHIVE}/${PLUGIN}-${VERSION}${ARCH}.md5"
        break
    fi
done

if [[ -z "${VERSION}" ]]; then
    echo "No available ${BASE_VERSION}.NN version slot found" >&2
    exit 1
fi

printf "%s\n" "${VERSION}" > "${VERSION_FILE}"
sed -i -e "s#\(ENTITY\s*version[^\"]*\).*#\1\"${VERSION}\">#" "${PLG_FILE}"
if [[ -f "${DEV_PLG_FILE}" ]]; then
    sed -i -e "s#\(ENTITY\s*version[^\"]*\).*#\1\"${VERSION}\">#" "${DEV_PLG_FILE}"
fi
if ! grep -q "^###${VERSION}$" "${PLG_FILE}"; then
    sed -i "/##&name/a\###${VERSION}" "${PLG_FILE}"
fi
if [[ -f "${DEV_PLG_FILE}" ]] && ! grep -q "^###${VERSION}$" "${DEV_PLG_FILE}"; then
    sed -i "/##&name/a\###${VERSION}" "${DEV_PLG_FILE}"
fi

mkdir -p "${TMPDIR}/"
cd "${DIR}"
cp --parents -f $(find . -type f ! \( -iname "pkg_build.sh" -o -iname "sftp-config.json" -o -iname ".DS_Store" \) ) "${TMPDIR}/"
cd "${TMPDIR}/"

if command -v makepkg >/dev/null 2>&1; then
    makepkg -l y -c y "${PACKAGE}"
else
    tar --sort=name --owner=0 --group=0 --numeric-owner -cJf "${PACKAGE}" .
fi

cd "${ARCHIVE}/"
md5sum "$(basename "${PACKAGE}")" > "${MD5}"
rm -rf "${TMPDIR}"

sum1=$(md5sum "${PACKAGE}")
sum2=$(cat "${MD5}")
if [ "${sum1:0:32}" != "${sum2:0:32}" ]; then
    echo "Checksum mismatched."
    rm "$MD5" "${PACKAGE}"
    exit 1
else
    echo "Checksum matched."
    echo "Built ${PACKAGE}"
fi
